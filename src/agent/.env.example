# Default: a self-hosted server exposing the OpenAI Chat Completions API.
# Examples: vLLM, llama.cpp server, LocalAI, LM Studio, Ollama OpenAI endpoint.
AGENT_PROVIDER=openai-compatible
AGENT_MODEL=your-tool-calling-model
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
# Leave empty when the local server does not require authentication.
OPENAI_COMPATIBLE_API_KEY=

# Optional alternative:
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

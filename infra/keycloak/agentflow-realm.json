{
  "realm": "agentflow",
  "enabled": true,
  "displayName": "AgentFlow",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "agentflow-api",
      "name": "AgentFlow API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "agentflow-cli",
      "name": "AgentFlow development CLI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "agentflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agentflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${KEYCLOAK_DEV_USER}",
      "enabled": true,
      "firstName": "AgentFlow",
      "lastName": "Developer",
      "email": "developer@agentflow.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}

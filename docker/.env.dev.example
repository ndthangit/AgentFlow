# Server development environment. Copy to .env.dev and replace every secret.
POSTGRES_DB=agentflow
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-dev-database-password

KEYCLOAK_ADMIN=dev-admin
KEYCLOAK_ADMIN_PASSWORD=change-dev-keycloak-admin-password
KEYCLOAK_DEV_USER=developer
KEYCLOAK_DEV_USER_ID=99f64c06-f5fa-4b38-a77b-335dbd925ef8
KEYCLOAK_DEV_USER_PASSWORD=change-dev-user-password
KEYCLOAK_USER_EMAIL=developer@example.com

# Public URLs seen by the browser. Do not add a trailing slash.
WEB_PUBLIC_URL=http://dev.example.com:3000
SYSTEM_PUBLIC_URL=http://dev.example.com:8000
KEYCLOAK_PUBLIC_URL=http://dev.example.com:8080

# Public application ports; infrastructure ports remain bound to loopback.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
SYSTEM_BIND_ADDRESS=0.0.0.0
SYSTEM_PORT=8000
KEYCLOAK_BIND_ADDRESS=0.0.0.0
KEYCLOAK_PORT=8080
MANAGEMENT_BIND_ADDRESS=127.0.0.1
KEYCLOAK_MANAGEMENT_PORT=9000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8002

AGENTFLOW_SYSTEM_IMAGE=agentflow-system:dev
AGENTFLOW_WEB_IMAGE=agentflow-web:dev
AGENTFLOW_AGENT_DEFAULT_IMAGE=agentflow-agent-default:dev
AGENTFLOW_AGENT_CODEX_IMAGE=agentflow-agent-codex:dev
AGENTFLOW_FILESYSTEM_MCP_IMAGE=agentflow-filesystem-mcp:dev

WORKFLOW_QUEUE_MAXLEN=10000
WORKFLOW_RECLAIM_IDLE_MS=300000
WORKFLOW_WORKER_REPLICAS=1

AGENT_RUNTIME_DEFAULT=default
AGENT_RUNTIME_TIMEOUT_SECONDS=180
AGENT_RUNTIME_MAX_CONTAINERS=2
AGENT_RUNTIME_CPUS=1
AGENT_RUNTIME_MEMORY=1g
AGENT_RUNTIME_PIDS_LIMIT=128
AGENT_RUNTIME_NETWORK=agentflow-dev-runtime
AGENT_RUNTIME_MAX_OUTPUT_BYTES=1048576

DEPLOYMENT_ENVIRONMENT=development
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER_ARG=0.25
OTEL_METRIC_EXPORT_INTERVAL=15000

# Optional Langfuse override (use together with compose.langfuse.yaml).
LANGFUSE_ENABLED=true
LANGFUSE_PORT=3002
LANGFUSE_PUBLIC_URL=https://langfuse.dev.example.com
LANGFUSE_PUBLIC_KEY=pk-lf-replace-development-key
LANGFUSE_SECRET_KEY=sk-lf-replace-development-key
LANGFUSE_INIT_USER_EMAIL=observability@example.com
LANGFUSE_INIT_USER_PASSWORD=replace-with-a-long-random-langfuse-password
LANGFUSE_POSTGRES_PASSWORD=replace-with-a-long-random-langfuse-postgres-password
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-a-long-random-langfuse-clickhouse-password
LANGFUSE_REDIS_PASSWORD=replace-with-a-long-random-langfuse-redis-password
LANGFUSE_MINIO_PASSWORD=replace-with-a-long-random-langfuse-minio-password
LANGFUSE_NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
LANGFUSE_SALT=replace-with-a-long-random-salt
# Generate exactly 64 hexadecimal characters, for example: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
LANGFUSE_MAX_IO_BYTES=65536
LANGFUSE_TRACES_SAMPLER_ARG=1.0
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false

# Development-only defaults. Copy this file to .env and replace every password.
POSTGRES_DB=agentflow
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-agentflow-db-password

# Redis Stream workflow queue tuning.
WORKFLOW_QUEUE_MAXLEN=10000
WORKFLOW_RECLAIM_IDLE_MS=300000
WORKFLOW_OUTBOX_REDISPATCH_SECONDS=60
WORKFLOW_WORKER_REPLICAS=1
WORKFLOW_LEASE_TTL_SECONDS=60
WORKFLOW_HEARTBEAT_SECONDS=10
WORKFLOW_RECOVERY_INTERVAL_SECONDS=10
WORKFLOW_TIMEOUT_SECONDS=900

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DEV_USER=developer
# Stable OIDC subject for the local development user. Keep this value unchanged.
KEYCLOAK_DEV_USER_ID=99f64c06-f5fa-4b38-a77b-335dbd925ef8
KEYCLOAK_DEV_USER_PASSWORD=change-developer-password

# One-shot runtimes built from src/agents/default, codex, opencode and openhands.
# Provider, model and API key are selected in Models/the workflow UI and injected
# only into that node's disposable container; they are not configured here.
AGENT_RUNTIME_DEFAULT=default
AGENT_RUNTIME_DEFAULT_IMAGE_VERSION=0.1.0
AGENT_RUNTIME_CODEX_IMAGE_VERSION=0.1.0
AGENT_RUNTIME_OPENCODE_IMAGE_VERSION=0.1.0
AGENT_RUNTIME_OPENHANDS_IMAGE_VERSION=0.1.0
AGENT_RUNTIME_TIMEOUT_SECONDS=180
AGENT_RUNTIME_MAX_STEPS=8
AGENT_RUNTIME_MAX_CONTAINERS=2
AGENT_RUNTIME_CPUS=1
AGENT_RUNTIME_MEMORY=1g
AGENT_RUNTIME_PIDS_LIMIT=128
# Dedicated network shared only by disposable Agent containers and demo MCPs.
AGENT_RUNTIME_NETWORK=agentflow-runtime
AGENT_RUNTIME_MAX_OUTPUT_BYTES=1048576

# Optional observability Compose override.
DEPLOYMENT_ENVIRONMENT=local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-grafana-password
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=15000

# Optional Langfuse override (use together with compose.langfuse.yaml).
LANGFUSE_ENABLED=true
LANGFUSE_PORT=3002
LANGFUSE_PUBLIC_URL=http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-agentflow-local
LANGFUSE_SECRET_KEY=sk-lf-agentflow-local
LANGFUSE_INIT_USER_EMAIL=admin@agentflow.local
LANGFUSE_INIT_USER_PASSWORD=change-langfuse-admin-password
LANGFUSE_POSTGRES_PASSWORD=change-langfuse-postgres-password
LANGFUSE_CLICKHOUSE_PASSWORD=change-langfuse-clickhouse-password
LANGFUSE_REDIS_PASSWORD=change-langfuse-redis-password
LANGFUSE_MINIO_PASSWORD=change-langfuse-minio-password
LANGFUSE_NEXTAUTH_SECRET=change-langfuse-nextauth-secret
LANGFUSE_SALT=change-langfuse-salt
# Exactly 64 hexadecimal characters.
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_MAX_IO_BYTES=65536
LANGFUSE_TRACES_SAMPLER_ARG=1.0
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false

# Production environment. Copy to .env.prod, use generated secrets, and never commit it.
POSTGRES_DB=agentflow
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

KEYCLOAK_ADMIN=agentflow-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
KEYCLOAK_DEV_USER=operator
KEYCLOAK_DEV_USER_ID=99f64c06-f5fa-4b38-a77b-335dbd925ef8
KEYCLOAK_DEV_USER_PASSWORD=replace-with-a-long-random-operator-password
KEYCLOAK_USER_EMAIL=operator@example.com

# HTTPS URLs exposed by the host reverse proxy. Do not add a trailing slash.
WEB_PUBLIC_URL=https://agentflow.example.com
SYSTEM_PUBLIC_URL=https://api.agentflow.example.com
KEYCLOAK_PUBLIC_URL=https://auth.agentflow.example.com

# Bind application services to loopback; the host reverse proxy terminates TLS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
SYSTEM_BIND_ADDRESS=127.0.0.1
SYSTEM_PORT=8000
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=8080
MANAGEMENT_BIND_ADDRESS=127.0.0.1
KEYCLOAK_MANAGEMENT_PORT=9000

# Immutable images built by CI for the public URLs above.
AGENTFLOW_SYSTEM_IMAGE=ghcr.io/your-org/agentflow-system:1.0.0
AGENTFLOW_WEB_IMAGE=ghcr.io/your-org/agentflow-web:1.0.0
AGENTFLOW_AGENT_RUNTIME_IMAGE=ghcr.io/your-org/agentflow-agent-runtime:1.0.0
AGENTFLOW_FILESYSTEM_MCP_IMAGE=ghcr.io/your-org/agentflow-filesystem-mcp:1.0.0

WORKFLOW_QUEUE_MAXLEN=50000
WORKFLOW_RECLAIM_IDLE_MS=300000
WORKFLOW_WORKER_REPLICAS=2

AGENT_RUNTIME_TIMEOUT_SECONDS=180
AGENT_RUNTIME_MAX_CONTAINERS=2
AGENT_RUNTIME_CPUS=1
AGENT_RUNTIME_MEMORY=1g
AGENT_RUNTIME_PIDS_LIMIT=128
AGENT_RUNTIME_NETWORK=agentflow-prod-runtime
AGENT_RUNTIME_MAX_OUTPUT_BYTES=1048576
